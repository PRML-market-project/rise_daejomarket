LOCAL_LLM_BASE_URL=http://127.0.0.1:8010/v1
LOCAL_LLM_MODEL=local-gemma
LOCAL_TTS_BASE_URL=http://127.0.0.1:8020
LOCAL_TTS_MODEL=qwen3-tts-0.6b-base-q8
AI_SERVER_PORT=8000
FLASK_DEBUG=false
STT_DEVICE=cpu
# Defaults to the project's data/models/whisper-tiny when bundled.
# WHISPER_MODEL_PATH=
# Q&A analysis log: one JSON line per /gpt request in logs/qa/qa-YYYY-MM.jsonl.
# QA_LOG_ENABLED=true
# QA_LOG_DIR=
# Optional fallback; leave unset for local inference only.
# OPENAI_API_KEY=
